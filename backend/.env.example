# PostgreSQL
POSTGRES_DB=miapp
POSTGRES_USER=miapp
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-local-secret

# Local service endpoints
GATEWAY_PORT=8080
SERVER_PORT=8080
AUTH_SERVICE_URI=http://localhost:8081
AUTH_DB_URL=jdbc:postgresql://localhost:5432/miapp
AUTH_DB_USERNAME=auth_runtime
AUTH_DB_PASSWORD=replace-with-auth-runtime-secret
AUTH_FLYWAY_USERNAME=auth_migrator
AUTH_FLYWAY_PASSWORD=replace-with-auth-migration-secret
# Symmetric key for pgcrypto (HU-18). Generate with a CSPRNG (e.g. openssl rand -base64 48). No single quotes.
AUTH_PII_ENCRYPTION_KEY=replace-with-a-random-key-of-at-least-32-chars
ENERGY_MARKET_SERVICE_URI=http://localhost:8082
ENERGY_MARKET_SERVER_PORT=8082
ENERGY_MARKET_DB_URL=jdbc:postgresql://localhost:5432/miapp
ENERGY_MARKET_DB_USERNAME=market_runtime
ENERGY_MARKET_DB_PASSWORD=replace-with-market-runtime-secret
ENERGY_MARKET_FLYWAY_USERNAME=market_migrator
ENERGY_MARKET_FLYWAY_PASSWORD=replace-with-market-migration-secret
ENERGY_MARKET_DB_SCHEMA=energy_market
ENERGY_MARKET_FLYWAY_ENABLED=true
ENERGY_MARKET_FLYWAY_LOCATIONS=classpath:db/migration
ENERGY_MARKET_LOG_LEVEL=INFO
RBAC_BOOTSTRAP_ADMIN_USERNAME=

# Development seed (F19). Keep DEV_SEED_ENABLED=false outside local development and demos.
# Run with: docker compose --profile seed up demo-seed --build
DEV_SEED_ENABLED=false
SEED_DEMO_PASSWORD=
SEED_DEMO_ADMIN_USERNAME=demo-admin
SEED_DEMO_ADMIN_EMAIL=demo-admin@example.test
SEED_AUDITOR_USERNAME=demo-auditor
SEED_NORMAL_USERS=8
SEED_DEVICES=4
SEED_READINGS_PER_DEVICE=10
SEED_OFFERS_TOTAL=20
SEED_CANCELLED_OFFERS=2
SEED_TRANSACTIONS=10

# JWT (use the same externally managed values in auth-service and api-gateway)
JWT_ISSUER=mi-app-auth
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=900000
AUTH_INTROSPECTION_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
AUTH_INTROSPECTION_TIMEOUT=2s

# Gateway CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Correlation-ID,Idempotency-Key
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Refresh-token cookie
REFRESH_TOKEN_EXPIRATION=604800000
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_MAX_AGE=604800000
